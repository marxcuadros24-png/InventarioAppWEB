# ============================================
# VARIABLES DE ENTORNO - EJEMPLO
# ============================================
# Copiar este archivo como .env y configurar los valores

# Servidor
PORT=3000
NODE_ENV=development

# Base de Datos SQL Server
DB_SERVER=localhost
DB_DATABASE=InventarioDB
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT (IMPORTANTE: Cambiar en producción)
JWT_SECRET=tu_clave_secreta_muy_larga_y_segura_cambiar_en_produccion_123456

# CORS (En producción, especificar el dominio)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
